{
    "name": "@guebbit/vue-library",
    "version": "1.0.0",
    "license": "AGPLv3.0",
    "main": "dist/index.js",
    "types": "types/index.d.ts",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm run docs:dev",
        "dev:wb": "vite --config vite.workbench.config.ts",
        "build": "run-p type-check-only \"build-only {@}\" --",
        "build-only": "vite build",
        "type-check-only": "vue-tsc --build --force",
        "preview": "vite preview",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "test": "npm run test:unit && npm run test:e2e",
        "test:unit": "vitest run",
        "test:unit:target": "vitest run tests/unit/SimpleButton.spec.ts",
        "test:e2e": "nightwatch --env chrome",
        "test:e2e:target": "nightwatch --continue-on-fail --test tests/e2e/SimpleButton.spec.ts --env chrome",
        "node:kill": "cmd \"/C TASKKILL /IM node.exe /F\"",
        "format": "prettier --write src/",
        "docs:dev": "vitepress dev docs --debug --port 8080",
        "docs:build": "vitepress build docs",
        "docs:serve": "vitepress serve docs --port 8080",
        "prepublish": "npm run lint && npm run test:unit && npm run build && npm run docs:build",
        "publish:public": "npm publish --access public",
        "clean_cache": "rm -rf node_modules/.vite && rm -rf docs/.vitepress/cache && rm -rf docs/.vitepress/dist"
    },
    "dependencies": {
        "@guebbit/css-toolkit": "^1.3.2",
        "@guebbit/css-ui": "file:../css-ui",
        "@guebbit/vue-toolkit": "file:../vue-toolkit",
        "dotenv": "^17.2.3",
        "vue": "^3.5.24"
    },
    "devDependencies": {
        "@emotion/is-prop-valid": "^1.4.0",
        "@mdi/font": "^7.4.47",
        "@nightwatch/vue": "^3.1.2",
        "@rushstack/eslint-patch": "^1.15.0",
        "@tsconfig/node22": "^22.0.3",
        "@types/jsdom": "^27.0.0",
        "@types/node": "^24.10.1",
        "@types/prismjs": "^1.26.5",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vitejs/plugin-vue-jsx": "^5.1.1",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.6.0",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.8.1",
        "change-case": "^5.4.4",
        "chromedriver": "^142.0.2",
        "eslint": "^9.39.1",
        "eslint-plugin-filenames": "^1.3.2",
        "eslint-plugin-html": "^8.1.3",
        "eslint-plugin-vue": "^10.6.2",
        "geckodriver": "^6.0.2",
        "jsdom": "^27.2.0",
        "nightwatch": "^3.12.3",
        "npm-run-all2": "^8.0.4",
        "postcss": "^8.5.6",
        "postcss-loader": "^8.2.0",
        "postcss-prefix-selector": "^2.1.1",
        "prettier": "^3.6.2",
        "prismjs": "^1.30.0",
        "sass": "^1.94.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vite": "^7.2.2",
        "vite-plugin-nightwatch": "^0.4.6",
        "vite-plugin-vue-devtools": "^8.0.3",
        "vitepress": "^1.6.4",
        "vitest": "^4.0.9",
        "vue-eslint-parser": "^10.2.0",
        "vue-tsc": "^3.1.4",
        "vuetify": "^3.10.11"
    }
}
